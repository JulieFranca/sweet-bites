rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated and active
    function isActive() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    // Helper: check if user is admin
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // Inventory
    match /inventory/{itemId} {
      allow read, write: if isActive()
        && request.auth.uid == resource.data.userId;

      allow create: if isActive();

      match /priceHistory/{historyId} {
        allow read, write: if isActive();
      }
    }

    // Recipes
    match /recipes/{recipeId} {
      allow read, write: if isActive()
        && request.auth.uid == resource.data.userId;
      allow create: if isActive();
    }

    // Products
    match /products/{productId} {
      allow read, write: if isActive()
        && request.auth.uid == resource.data.userId;
      allow create: if isActive();
    }

    // Production
    match /production/{productionId} {
      allow read, write: if isActive()
        && request.auth.uid == resource.data.userId;
      allow create: if isActive();
    }

    // Shopping Lists
    match /shoppingList/{listId} {
      allow read, write: if isActive()
        && request.auth.uid == resource.data.userId;
      allow create: if isActive();

      match /items/{itemId} {
        allow read, write: if isActive();
      }
    }

    // Conversion Table (read: all active, write: admin only)
    match /conversionTable/{convId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Notifications
    match /notifications/{userId}/items/{notificationId} {
      allow read, write: if request.auth.uid == userId;
    }
  }
}
